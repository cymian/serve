#!/bin/sh

if [ "$GIT_BATCH_PUSH_CONFIRMED" = "1" ]; then
  exit 0
fi

updates=$(cat)

if ! ( : > /dev/tty ) 2>/dev/null; then
  echo "Refusing push: confirmation requires an interactive terminal." >&2
  exit 1
fi

remote_name=$1

{
  printf '\nPushing to %s:\n' "$remote_name"
  printf '%s\n' "$updates" |
    while IFS=' ' read -r local_ref _local_oid remote_ref _remote_oid; do
      printf '  %s -> %s\n' "$local_ref" "$remote_ref"
    done
  printf 'Type "push %s" to continue: ' "$remote_name"
} > /dev/tty

IFS= read -r confirmation < /dev/tty

if [ "$confirmation" != "push $remote_name" ]; then
  echo "Push cancelled." > /dev/tty
  exit 1
fi

{
  "name": "@cymian/serve",
  "license": "MIT",
  "version": "0.2.0",
  "exports": {
    ".": "./src/mod.ts",
    "./guard": "./src/requestGuard.ts"
    // - its own entry so an app server can take the guard without pulling in
    //   @std/http, which only the static server needs
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/http": "jsr:@std/http@^1"
  },
  "tasks": {
    // Check
    "check": "deno check src/",
    "lint": "deno lint src/",
    "test": "deno test -R=. -W=.test-dist -N=127.0.0.1,0.0.0.0 -S=networkInterfaces src/",
    // - the whole repo, not just src/: the dotfile and dir-listing specs serve
    //   the repo root, which is the only fixture carrying both
    //
    // Publish
    "publish:dry": "deno publish --dry-run",
    //
    // Hooks
    "pre-commit": "deno fmt && deno lint src/ && deno check src/ && deno task test",
    "setup": "git config core.hooksPath .hooks"
  },
  "publish": {
    "exclude": [
      "**/*.test.ts",
      ".github/",
      ".hooks/",
      "notes/",
      ".gitattributes",
      "$config",
      "deno.lock"
    ]
  }
}

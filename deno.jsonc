{
  "name": "@cymian/serve",
  "version": "0.1.0",
  "exports": "./src/mod.ts",
  "license": "MIT",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/http": "jsr:@std/http@^1"
  },
  "tasks": {
    // Check
    "check": "deno check src/",
    "lint": "deno lint src/",
    "test": "deno test -R=src -N=127.0.0.1,0.0.0.0 src/",
    //
    // Publish
    "publish:dry": "deno publish --dry-run",
    //
    // Hooks
    "pre-commit": "deno fmt --check && deno lint src/ && deno check src/ && deno task test",
    "setup": "deno eval \"Deno.copyFileSync('.hooks/pre-commit', '.git/hooks/pre-commit'); try { Deno.chmodSync('.git/hooks/pre-commit', 0o755) } catch {}\""
  },
  "publish": {
    "exclude": ["**/*.test.ts", ".hooks/"]
  }
}

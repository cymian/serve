{
  "name": "@cymian/serve",
  "version": "0.1.0",
  "exports": {
    ".": "./src/mod.ts",
    "./requestGuard": "./src/requestGuard.ts"
    // - its own entry so an app server can take the guard without pulling in
    //   @std/http, which only the static server needs
  },
  "license": "MIT",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/http": "jsr:@std/http@^1"
  },
  "tasks": {
    // Check
    "check": "deno check src/",
    "lint": "deno lint src/",
    "test": "deno test -R=src -N=127.0.0.1,0.0.0.0 -S=networkInterfaces src/",
    //
    // Publish
    "publish:dry": "deno publish --dry-run",
    //
    // Hooks
    "pre-commit": "deno fmt && deno lint src/ && deno check src/ && deno task test",
    "setup": "git config core.hooksPath .hooks"
    // - one-time per clone: .git/config is not trackable, so nothing carries
    //   the setting with the repo
  },
  "fmt": {
    "exclude": ["notes/"]
    // - deno fmt rewrites *emphasis* to _emphasis_, and `*direction*:` is a
    //   marker the todo file's structure depends on
  },
  "publish": {
    "exclude": ["**/*.test.ts", ".hooks/", "notes/"]
  }
}
